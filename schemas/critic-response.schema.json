{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-foundry.invalid/schemas/critic-response.schema.json",
  "title": "Game Foundry independent critic response",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "summary", "findings"],
  "properties": {
    "decision": {"enum": ["pass", "block"]},
    "summary": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "summary", "evidence_refs", "recommended_action"],
        "properties": {
          "severity": {"enum": ["blocker", "warning", "observation"]},
          "category": {"enum": ["requirements", "design", "guidelines", "scope", "evidence", "quality", "integrity"]},
          "summary": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["DESIGN", "GUIDELINES", "TASK", "TASK_PROMPT", "PATCH", "CHANGED_FILES", "SCOPE_RESULT", "VALIDATOR", "VALIDATION_RESULT", "VALIDATION_LOG"]}
          },
          "recommended_action": {"type": "string"}
        }
      }
    }
  }
}
