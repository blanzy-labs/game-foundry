{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-foundry.invalid/schemas/approval.schema.json",
  "title": "Game Foundry approval integration record",
  "type": "object",
  "required": ["schema_version", "approval_id", "approval_type", "project_id", "repository", "units", "evidence_bindings", "remote", "target_branch", "integration", "validation_commands"],
  "properties": {
    "schema_version": {"const": 1},
    "approval_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]+$"},
    "approval_type": {"enum": ["candidate_bundle", "adoption_bundle"]},
    "project_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "units": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "validation_evidence", "critic_required"], "properties": {"id": {"type": "string", "minLength": 1}, "validation_evidence": {"type": "string", "minLength": 1}, "critic_required": {"type": "boolean"}, "critic_evidence": {"type": "string", "minLength": 1}}}},
    "remote": {"type": "string", "minLength": 1},
    "target_branch": {"type": "string", "minLength": 1},
    "integration": {
      "type": "object",
      "required": ["mode", "allow_force_push", "verify_remote"],
      "properties": {
        "mode": {"enum": ["direct", "pull_request"]},
        "allow_force_push": {"const": false},
        "verify_remote": {"const": true},
        "pr_adapter": {"enum": ["fixture", "github"]},
        "external_reviewer_required": {"type": "boolean"},
        "merge_method": {"enum": ["merge", "squash", "rebase"]},
        "required_checks": {"type": "boolean"},
        "require_strict_base_checks": {"type": "boolean"}
      }
    },
    "validation_commands": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
    "evidence_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["unit_id", "validation_sha256"], "properties": {"unit_id": {"type": "string"}, "validation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "critic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "milestone_gates": {"type": "array", "items": {"type": "object", "required": ["milestone_id", "task_ids"], "properties": {"milestone_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"}, "task_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}},
    "candidate_patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_commits": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["sha", "tree_sha", "unit_ids", "paths"], "properties": {"sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}, "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}, "unit_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}}
  },
  "additionalProperties": true
}
