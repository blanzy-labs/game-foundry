{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-foundry.invalid/schemas/approval-bundle.schema.json",
  "title": "Game Foundry approval bundle",
  "type": "object",
  "required": ["approval_id", "units", "candidate_commits"],
  "properties": {
    "approval_id": {"type": "string"},
    "units": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "validation_evidence", "critic_required"]}},
    "candidate_commits": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["sha", "tree_sha", "unit_ids", "paths"]}},
    "candidate_patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
