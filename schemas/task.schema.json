{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-foundry.invalid/schemas/task.schema.json",
  "title": "Game Foundry milestone task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "objective", "depends_on", "allowed_scope", "acceptance", "retry_policy", "on_failure"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$"}},
    "allowed_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts"],
      "properties": {"max_attempts": {"type": "integer", "minimum": 1}}
    },
    "on_failure": {"enum": ["retry", "escalate"]},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "args", "timeout_seconds", "success_markers"],
      "properties": {
        "type": {"const": "repo_script"},
        "path": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "success_markers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "notes": {"type": "string"},
    "expected_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "design_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "priority": {"type": "integer"}
  }
}
